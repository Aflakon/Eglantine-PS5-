+
+u64 StagingBufferPool::TrimIdle(u64 before_tick, u32 min_log2, size_t keep_per_level) {
+    u64 freed = 0;
+    for (StagingBuffersCache* cache : {&device_local_cache, &upload_cache, &download_cache}) {
+        for (size_t log2 = min_log2; log2 < NUM_LEVELS; ++log2) {
+            StagingBuffers& level = (*cache)[log2];
+            if (level.entries.size() <= keep_per_level) {
+                continue;
+            }
+            size_t kept = 0;
+            const size_t old_size = level.entries.size();
+            std::erase_if(level.entries, [&](const StagingBuffer& entry) {
+                if (entry.deferred || entry.tick >= before_tick || !scheduler.IsFree(entry.tick)) {
+                    return false;
+                }
+                if (kept < keep_per_level) {
+                    ++kept;
+                    return false;
+                }
+                freed += u64{1} << log2;
+                return true;
+            });
+            if (level.entries.size() != old_size) {
+                level.delete_index = 0;
+                level.iterate_index = 0;
+            }
+        }
+    }
+    return freed;
+}
+
+void StagingBufferPool::Touch(const StagingBufferRef& ref) {
+    if (ref.log2_level >= NUM_LEVELS) {
+        return;
+    }
+    for (StagingBuffer& entry : GetCache(ref.usage)[ref.log2_level].entries) {
+        if (entry.index == ref.index && *entry.buffer == ref.buffer) {
+            if (!entry.deferred) {
+                entry.tick = (std::max)(entry.tick, scheduler.CurrentTick());
+            }
+            return;
+        }
+    }
+}
+
+u64 StagingBufferPool::IdleBytes(u64 before_tick, u32 min_log2) const {
+    u64 bytes = 0;
+    for (const StagingBuffersCache* cache : {&device_local_cache, &upload_cache, &download_cache}) {
+        for (size_t log2 = min_log2; log2 < NUM_LEVELS; ++log2) {
+            for (const StagingBuffer& entry : (*cache)[log2].entries) {
+                if (!entry.deferred && entry.tick < before_tick) {
+                    bytes += u64{1} << log2;
+                }
+            }
+        }
+    }
+    return bytes;
 }
 
