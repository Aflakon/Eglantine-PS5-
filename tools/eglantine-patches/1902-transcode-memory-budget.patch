+bool TextureCacheRuntime::RelieveMemory() {
+    // Not from another thread (these lists are the transcoding thread's), and not from inside
+    // itself. It never submits: the caller may be between recording a draw's bindings and the
+    // draw. It waits for the work already submitted, and frees what only that work used.
+    static thread_local bool relieving = false;
+    if (relieving || relief_thread.load(std::memory_order_relaxed) != std::this_thread::get_id()) {
+        return false;
+    }
+    const u64 current = scheduler.CurrentTick();
+    const bool images = !free_transcodes.empty() ||
+                        (!pending_transcodes.empty() && pending_transcodes.front().tick < current);
+    const u64 staging = transcoding ? 0 : staging_buffer_pool.IdleBytes(current, 20);
+    if (!images && staging == 0) {
+        return false;
+    }
+    relieving = true;
+    if (current > 1) {
+        scheduler.Wait(current - 1);
+    }
+    const auto decode_bytes = [](const PendingTranscode& t) {
+        u64 bytes = 0;
+        for (u32 level = 0; level < t.levels; ++level) {
+            bytes += u64{(std::max)(t.width >> level, 1U)} * (std::max)(t.height >> level, 1U) * 4;
+        }
+        return bytes * t.layers;
+    };
+    u64 freed = 0;
+    for (const PendingTranscode& t : free_transcodes) {
+        freed += decode_bytes(t);
+    }
+    free_transcodes.clear();
+    while (!pending_transcodes.empty() && pending_transcodes.front().tick < current) {
+        freed += decode_bytes(pending_transcodes.front());
+        pending_transcodes.pop_front();
+    }
