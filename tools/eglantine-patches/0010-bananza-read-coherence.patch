diff --git a/src/video_core/nx2.h b/src/video_core/nx2.h
index 8dad105acbe769d0359724afb967803cbc1d2f9f..6f420bc0827b7ef47d9cc79fa8b7a8e1494dbd02 100644
--- a/src/video_core/nx2.h
+++ b/src/video_core/nx2.h
@@ -25,6 +25,23 @@ inline std::atomic<bool> g_nx2_ampere{false};
 // The running title, for the few places that must behave differently per game.
 inline std::atomic<u64> g_nx2_program_id{0};
 
+// Read coherence for GPU-written buffers without a fastmem arena (64-bit titles on the PS5): a
+// guest core keeps the last area it flushed and skips later flushes inside it until the read-trap
+// generation moves, which only arming traps did, and traps need fastmem. Every GPU write that
+// re-arms now moves the generation, and a clean area read drops its trapped range so the next
+// GPU write there re-arms (upstream's readback-coherence correction). Donkey Kong Bananza's world
+// stayed unrendered (a purple screen) reading stale GPU results; Mario Kart World keeps the old
+// behaviour, which its title-screen frame rate depends on. EDEN_NX2_READ_COHERENCE=1 turns it on
+// for every title, =0 off.
+inline bool Nx2ReadCoherence() {
+    static const int mode = [] {
+        const char* value = std::getenv("EDEN_NX2_READ_COHERENCE");
+        return value == nullptr ? -1 : (value[0] == '0' ? 0 : 1);
+    }();
+    return mode == 1 || (mode == -1 && g_nx2_program_id.load(std::memory_order_relaxed) ==
+                                           0x040074A01BF12000ULL);
+}
+
 // Titles whose guest side reads GPU-written buffer data through a path the buffer cache does not
 // see, so their buffers must be copied back to guest memory at every fence
 // (BufferCache::AsyncBufferDownloads, EDEN_NX2_BUFFER_DOWNLOADS). 0400A3A01EE4C000 is Pokemon
